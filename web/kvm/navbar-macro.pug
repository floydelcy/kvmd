li.right#macro-dropdown
	.menu-item.menu-button(href="#")
		+navbar_led("hid-recorder-led", "led-gear")
		span(i18n="kvm_macro_text1") Macro

	.hidden.menu
		.text
			b(i18n="kvm_macro_text2") Record and play HID/ATX/GPIO actions#[br]
			sub(i18n="kvm_macro_text3") For security reasons, the record will not be saved on the PiKVM

		.buttons.buttons-row
			button.row25#hid-recorder-record(disabled data-wm-menu-force-hide i18n="kvm_macro_text5") &bull; Rec
			button.row25#hid-recorder-stop(disabled i18n="kvm_macro_text5") Stop
			button.row25#hid-recorder-play(disabled i18n="kvm_macro_text6") Play
			button.row25#hid-recorder-clear(disabled i18n="kvm_macro_text7") Clear

		table.kv
			tr
				td(i18n="kvm_macro_text8") Script time:
				td.value#hid-recorder-time(colspan="2") 00:00:00.0
			tr
				td(i18n="kvm_macro_text9") Scripted events:
				td.value#hid-recorder-events-count 0
				td #[sup #[i(i18n="kvm_macro_text10") include delays]]
		hr

		+menu_switch_table("hid-recorder-loop-switch", false, false) Infinite loop playback:

		input#hid-recorder-new-script-file(type="file" style="display: none")
		.buttons.buttons-row
			button.row50#hid-recorder-upload(disabled i18n="kvm_macro_text11") Upload script
			button.row50#hid-recorder-download(disabled i18n="kvm_macro_text12") Download script