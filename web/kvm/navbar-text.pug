li.right#text-dropdown
	a.menu-button(href="#")
		+navbar_led("stream-ocr-led", "led-gear", "feature-disabled")
		span(i18n="kvm_text_text1") Text

	.menu#text-menu
		.text
			b(i18n="kvm_text_text2") Paste text as keypress sequence#[br]
			sub(i18n="kvm_text_text3") Please note that PiKVM cannot switch the keyboard layout
		hr
		.text(style="margin-right: 20px")
			textarea#hid-pak-text(data-focus placeholder="Enter your text here")
		table.kv
			tr
				td #[button#hid-pak-button(disabled data-force-hide-menu i18n="kvm_text_text4") &bull; Paste]
				td(i18n="kvm_text_text5") using host keymap
				td #[select#hid-pak-keymap-selector]
		table.kv
			tr
				+menu_switch_td2("hid-pak-slow-switch", true, false) Slow typing:
			tr
				+menu_switch_td2("hid-pak-secure-switch", true, false) Hide input text:
			tr
				+menu_switch_td2("hid-pak-ask-switch", true, true) Ask paste confirmation:

		.feature-disabled#stream-ocr
			hr
			br
			hr
			.text
				b(i18n="kvm_text_text6") Text recognition <sup><i>&beta;</i></sup>#[br]
				sub(i18n="kvm_text_text7") #[a(target="_blank" href="https://docs.pikvm.org/ocr") OCR] works locally on PiKVM
			hr
			table.kv
				tr
					td #[button#stream-ocr-button(data-force-hide-menu i18n="kvm_text_text8") &bull; Select area]
					td(i18n="kvm_text_text9") for
					td #[select#stream-ocr-lang-selector]
					td(i18n="kvm_text_text10") text recognition
			table.kv
				tr
					td(colspan="4" i18n="kvm_text_text11") &bull; Press #[b Enter] to recognize and copy text to clipboard
				tr
					td(colspan="4" i18n="kvm_text_text12") &bull; Press #[b Esc] to cancel selection
				tr
					td
