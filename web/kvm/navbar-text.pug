li.right#text-dropdown
	.menu-item.menu-button(href="#")
		+navbar_led("stream-ocr-led", "led-gear", "feature-disabled")
		span(i18n="kvm_text_text1") Text

	.hidden.menu#text-menu(style="width: 360px")
		.text
			b(i18n="kvm_text_text2") Paste text as keypress sequence#[br]
			sub(i18n="kvm_text_text3") Please note that PiKVM cannot switch the keyboard layout
		hr
		.text(style="margin-right: 20px")
			textarea#hid-pak-text(data-wm-menu-focus placeholder="Enter your text here")
		table.kv
			tr
				td #[button#hid-pak-button(disabled data-wm-menu-force-hide title="Ctrl+Enter when the text is focused" i18n="kvm_text_text4" data-i18n-title="kvm_text_title4") &bull; Paste]
				td(i18n="kvm_text_text5") using a host keymap
				td #[select#hid-pak-keymap-selector]
		table.kv
			tr
				+menu_slider_td3("hid-pak-delay-slider", "hid-pak-delay-value", true) Delay between keys:
			tr
				+menu_switch_td2("hid-pak-secure-switch", true, false) Hide input text:
			tr
				+menu_switch_td2("hid-pak-ask-switch", true, true) Ask paste confirmation:

		.feature-disabled#stream-ocr
			hr
			br
			hr
			.text
				b(i18n="kvm_text_text6") Text recognition#[br]
				sub(i18n="kvm_text_text7") #[a(target="_blank" href="https://docs.pikvm.org/ocr") OCR] works locally on PiKVM
			hr
			table.kv
				tr
					td #[button#stream-ocr-button(data-wm-menu-force-hide i18n="kvm_text_text8") &bull; Select area]
					td(i18n="kvm_text_text9") for
					td #[select#stream-ocr-lang-selector]
					td(i18n="kvm_text_text10") text recognition
			table.kv
				tr
					td(colspan="4" i18n="kvm_text_text11") &bull; Next hit the #[b Enter] to recognize and copy text to clipboard...
				tr
					td(colspan="4" i18n="kvm_text_text12") &bull; Or hit the #[b Escape] to cancel a selection
				tr
					td
