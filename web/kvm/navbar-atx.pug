li.right.feature-disabled#atx-dropdown
	a.menu-button(href="#")
		+navbar_led("atx-power-led", "led-atx-power")
		+navbar_led("atx-hdd-led", "led-atx-hdd")
		span(i18n="kvm_atx_text1") ATX

	.menu
		.text
			b(i18n="kvm_atx_text2") Control the server's power#[br]
			sub(i18n="kvm_atx_text3") Use the short click for ACPI shutdown
		hr
		+menu_switch_table("atx-ask-switch", true, true) Ask click confirmation:
		hr
		.buttons
			button#atx-power-button(disabled data-force-hide-menu) &bull; Click Power #[sup #[i(i18n="kvm_atx_text4") short]]
			button#atx-power-button-long(disabled data-force-hide-menu) &bull; Click Power #[sup #[i(i18n="kvm_atx_text5") long]]
			hr
			button#atx-reset-button(disabled data-force-hide-menu) &bull; Click Reset